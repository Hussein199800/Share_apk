<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. A copied TLS key would make two phones share one LocalSend identity. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="localsend.p12" />
        <exclude domain="file" path="received/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="localsend.p12" />
        <exclude domain="file" path="received/" />
    </device-transfer>
</data-extraction-rules>
